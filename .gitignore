# ==============================================================================
# .gitignore para Proyecto PDV Abarrotes Arenas
# ==============================================================================

# Bases de datos pesadas y binarios externos
PDVDATA.FDB
*.FDB
*.fdb
firebird25/
firebird25_embed/

# Python & Scripts temporales
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# .NET / Visual Studio
bin/
obj/
*.user
*.userosscache
*.suo
*.userprefs
.vs/
.vscode/
*.DotSettings.user
*.nupkg
project.lock.json
global.json

# Node.js / React / Vite
node_modules/
dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs y Auditorías generadas
*.log
logs/
sql_schema_audit.json

# Archivos de entorno y secretos
.env
.env.*
!.env.example

# Despliegues y binarios temporales
backend/publish_linux/
deploy_vps/
deploy_vps.tar.gz
